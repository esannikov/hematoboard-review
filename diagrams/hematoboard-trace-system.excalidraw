      "seed": 1550649258,
      "version": 3,
      "versionNonce": 994230390,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "DETERMINISTIC · STRUCTURE + DE-IDENTIFICATION<br>Rebuilds table fields and removes identifiers\nwithout changing source geometry.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "cClgQPcP6saIryf4eL1YG",
      "originalText": "DETERMINISTIC · STRUCTURE + DE-IDENTIFICATION<br>Rebuilds table fields and removes identifiers without changing source geometry.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gmKGeekf6F5H_eK7KsJCI",
      "type": "text",
      "x": 3377.0966796875,
      "y": 156.25,
      "width": 1059.541015625,
      "height": 25,
      "angle": 0,
