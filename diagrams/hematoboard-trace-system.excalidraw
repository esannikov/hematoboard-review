      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "STATE · ACCEPTED EVIDENCE LEDGER<br>Canonical measurements, dates, findings and provenance; agents\ncan only read it.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "TjCxWYS35RZQjoCMc9elY",
      "originalText": "STATE · ACCEPTED EVIDENCE LEDGER<br>Canonical measurements, dates, findings and provenance; agents can only read it.",
      "autoResize": true,
