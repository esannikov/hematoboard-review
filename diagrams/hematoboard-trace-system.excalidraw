      "versionNonce": 1237892202,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "AGENTIC · AI AGENT ORCHESTRATOR<br>Chooses permitted operations, calls tools and bounded agents, and\nrecords receipts.<br>Cannot approve clinical facts or publish accepted state.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-jFm-siBZlzDj8z0n2_NJ",
      "originalText": "AGENTIC · AI AGENT ORCHESTRATOR<br>Chooses permitted operations, calls tools and bounded agents, and records receipts.<br>Cannot approve clinical facts or publish accepted state.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7jn4MrDeacb5cQ4zS9F1V",
      "type": "text",
      "x": 140.4482421875,
      "y": 143.75,
      "width": 860.400390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "subgraph_group_L"
      ],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 549325354,
      "version": 3,
      "versionNonce": 561977142,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "DETERMINISTIC · PRIVATE INTAKE<br>Isolates the case, inventories pages, preserves the original and\nrecords hashes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "mTXAmWHeP8TJNOwh6R3eZ",
      "originalText": "DETERMINISTIC · PRIVATE INTAKE<br>Isolates the case, inventories pages, preserves the original and records hashes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Eh70zSA1ehzZC1QBHumhz",
      "type": "text",
      "x": 1219.17578125,
      "y": 143.75,
      "width": 850.8203125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
