    {
      "id": "P64DN6-q-aT4bB4PUPsMp",
      "type": "text",
      "x": 155.98046875,
      "y": 301.25,
      "width": 829.3359375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
