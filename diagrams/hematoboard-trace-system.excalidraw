      "versionNonce": 2123995894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "PRIMARY PUBLIC OUTPUT · HEMATOBOARD DASHBOARD<br>Shows accepted state and a separate candidate across overview,\ntimeline and graph. Read-only: it never writes clinical state.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "RSffow-PfwVaWlQ8GygKC",
      "originalText": "PRIMARY PUBLIC OUTPUT · HEMATOBOARD DASHBOARD<br>Shows accepted state and a separate candidate across overview, timeline and graph. Read-only: it never writes clinical state.",
      "autoResize": true,
      "lineHeight": 1.25
    },
