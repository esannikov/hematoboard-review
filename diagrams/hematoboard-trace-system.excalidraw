    {
      "id": "z8jabuZsvCHemWriO4fvE",
      "type": "text",
      "x": 8332.1640625,
      "y": 474.25,
      "width": 838.75,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
