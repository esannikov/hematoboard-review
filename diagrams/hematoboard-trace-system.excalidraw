      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "DETERMINISTIC · PROJECTION + DOM CLOSURE<br>Builds every view and blocks review if any\nrendered field differs from its source.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "7-6lQH7ynB0fasTuXz3SX",
      "originalText": "DETERMINISTIC · PROJECTION + DOM CLOSURE<br>Builds every view and blocks review if any rendered field differs from its source.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VbdL-FCtyGMGw-P6upAyU",
      "type": "text",
      "x": 9502.14453125,
      "y": 474.25,
      "width": 893.3984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#8f2d00",
