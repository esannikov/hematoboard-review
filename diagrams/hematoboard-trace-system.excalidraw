      "version": 3,
      "versionNonce": 185179946,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "LOCAL MODEL · APPLE VISION OCR<br>Reads text, confidence and word positions locally; the PDF\nremains pixel truth.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "mmxVKIgKzdgQezh6o3TCS",
      "originalText": "LOCAL MODEL · APPLE VISION OCR<br>Reads text, confidence and word positions locally; the PDF remains pixel truth.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wH9RJZCElc2Q6q1dj6_M7",
      "type": "text",
      "x": 2159.6181640625,
      "y": 143.75,
      "width": 891.513671875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
