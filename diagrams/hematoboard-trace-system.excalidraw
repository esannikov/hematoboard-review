      "isDeleted": false,
      "boundElements": null,
      "updated": 1786185850593,
      "link": null,
      "locked": false,
      "text": "HYBRID · SOURCE REVIEW<br>Terra reads privacy-screened crops; exact consensus closes fields, disagreement reopens review.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "egDvLQcPYu8nxpUQd9FSe",
      "originalText": "HYBRID · SOURCE REVIEW<br>Terra reads privacy-screened crops; exact consensus closes fields, disagreement reopens review.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xsB-a_HjmWR6Jfv43wcGg",
      "type": "text",
      "x": 4796.1630859375,
      "y": 388.25,
      "width": 923.564453125,
      "height": 50,
      "angle": 0,
